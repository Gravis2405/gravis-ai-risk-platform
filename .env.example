PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
INGEST_API_KEY=replace-with-a-separate-long-random-ingestion-key
APP_ORIGIN=http://localhost:5000
DATA_FILE=./data/gravis.json
# Optional. When set, workspace records are stored in PostgreSQL instead of DATA_FILE.
DATABASE_URL=
# Production first-run only: set these secrets until the initial admin is created, then remove them.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional SMS verification. Store real values in the deployment host's secret settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

